  "captions": [
    {"from": 0.0, "to": 3.2, "text": "The fund that gave the highest returns in the last 5 years,"},
    {"from": 3.2, "to": 5.18, "text": "do you trust that very fund?"},
    {"from": 5.18, "to": 8.9, "text": "But data says 4 out of 5 top funds"},
    {"from": 8.9, "to": 11.58, "text": "lose that position in the next 5 years."},
    {"from": 11.58, "to": 15.64, "text": "There was even a time when, out of 100 top funds,"},
    {"from": 15.64, "to": 19.32, "text": "only 4 managed to stay on top for the next 5 years."},
    {"from": 19.32, "to": 22.92, "text": "And you're still looking only at past returns?"},
    {"from": 22.92, "to": 25.08, "text": "FundsIndia's October 2026 report"},
    {"from": 25.08, "to": 27.4, "text": "analysed diversified equity funds such as"},
    {"from": 27.4, "to": 30.7, "text": "large-cap, mid-cap, small-cap, flexi-cap,"},
    {"from": 30.7, "to": 35.82, "text": "multi-cap, ELSS, focused and value/contra funds."},
    {"from": 35.82, "to": 39.18, "text": "Of the funds that were in the top 25% over 5 years,"},
    {"from": 39.18, "to": 43.52, "text": "on average, only 21% stayed there for the next 5 years too."},
    {"from": 43.52, "to": 46.24, "text": "For 3 years, this number was 26%."},
    {"from": 46.24, "to": 48.9, "text": "In some periods, it was even worse."},
    {"from": 48.9, "to": 52.24, "text": "Of the top funds of 2007 to 2011,"},
    {"from": 52.24, "to": 55.82, "text": "only 4% stayed on top for the next 5 years."},
    {"from": 55.82, "to": 59.36, "text": "Yes, of the top funds of 2014 to 2018,"},
    {"from": 59.36, "to": 60.78, "text": "48% did stay on,"},
    {"from": 60.78, "to": 63.64, "text": "which means this pattern isn't the same every time."},
    {"from": 63.64, "to": 64.26, "text": "The reason?"},
    {"from": 64.26, "to": 66.42, "text": "The market's leader keeps changing."},
    {"from": 66.42, "to": 68.8, "text": "Sometimes small caps lead, sometimes large caps."},
    {"from": 68.8, "to": 72.5, "text": "In 2023 and 2024, small-cap indices"},
    {"from": 72.5, "to": 74.5, "text": "left large and mid caps behind,"},
    {"from": 74.5, "to": 77.54, "text": "but in 2025, large caps pulled ahead."},
    {"from": 77.54, "to": 78.9, "text": "One more thing."},
    {"from": 78.9, "to": 82.08, "text": "Dropping out of the top 25% doesn't mean"},
    {"from": 82.08, "to": 83.52, "text": "the fund's returns are bad."},
    {"from": 83.52, "to": 86.28, "text": "Other funds may simply have moved ahead."},
    {"from": 86.28, "to": 89.06, "text": "Also, this data combines different categories,"},
    {"from": 89.06, "to": 92.12, "text": "so the rankings also include differences between market segments."},
    {"from": 92.12, "to": 94.58, "text": "So, not just past returns."},
    {"from": 94.58, "to": 96.86, "text": "Look at performance across different market conditions,"},
    {"from": 96.86, "to": 99.56, "text": "consistency against the benchmark and category,"},
    {"from": 99.56, "to": 101.04, "text": "and risk too."},
    {"from": 101.04, "to": 104.48, "text": "This is data from a study, not a recommendation."},
    {"from": 104.48, "to": 107.34, "text": "Past performance does not guarantee future results,"},
    {"from": 107.34, "to": 110.3, "text": "so it's important to look beyond returns too."}
  ]
